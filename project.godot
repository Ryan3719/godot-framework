; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Godot Framework"
run/main_scene="res://tests/test_runner.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

GodotFramework="*res://addons/godot_framework/runtime/framework_host.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_framework/plugin.cfg")

[godot_framework]

auto_boot=true
config_path="res://addons/godot_framework/config/default_framework_config.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
